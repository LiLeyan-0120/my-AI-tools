# Local-only bind by default. Change only if you know you need remote access.
CLI_PROXY_API_ENDPOINT=http://127.0.0.1:3000
CLI_PROXY_API_KEY=change-me-local-gateway-key
CLI_PROXY_API_PORT=3000
CLI_PROXY_API_HOST=127.0.0.1
# Change this before exposing management endpoints beyond localhost.
CLI_PROXY_API_MANAGEMENT_KEY=change-me-management-key
CLI_PROXY_API_PINNED_TAG=v6.9.16
CLI_PROXY_API_PINNED_COMMIT=c8b7e2b8d6f24462b724925dfe4f984ae6b9e302
CLI_PROXY_API_CONFIG=.\config\cli-proxy-config.yaml
CLI_PROXY_API_GO_IMAGE=docker.m.daocloud.io/library/golang:1.26-alpine
CLI_PROXY_API_RUNNER_IMAGE=docker.m.daocloud.io/library/alpine:3.22.0
CLI_PROXY_API_GOPROXY=https://goproxy.cn,direct
CLI_PROXY_API_GOSUMDB=sum.golang.google.cn
CLI_PROXY_API_IMAGE_TAG=cliproxyapi-wrapper:v6.9.16
CLI_PROXY_API_CONTAINER_NAME=cliproxyapi-claude-gateway
CLI_PROXY_API_USE_LOCAL_CODEX_AUTH_JSON=true
CLI_PROXY_API_CODEX_WEBSOCKETS=false
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
CLAUDE_PROVIDER_NAME=CLIProxyAPI Claude
CLAUDE_PROVIDER_MODEL=gpt-5.4
